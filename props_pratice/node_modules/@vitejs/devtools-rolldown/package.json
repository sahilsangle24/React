  "files": [
    "dist"
  ],
  "dependencies": {
    "@rolldown/debug": "^1.2.16",
    "@vitejs/devtools-kit": "0.8.3",
    "diff": "^9.0.0",
    "nostics": "^1.3.0",
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@unocss/nuxt": "^66.12.0",
    "@vitejs/devtools-ui": "0.8.3",
    "@vueuse/components": "^15.0.0",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "@vueuse/router": "^15.0.0",
    "comlink": "^4.4.2",
    "d3-hierarchy": "^3.1.2",
    "d3-shape": "^3.2.1",
    "devframe": "^1.3.5",
    "diff-match-patch-es": "^2.0.1",
    "floating-vue": "^5.4.0",
    "fuse.js": "^7.5.0",
