{
  "name": "@devframes/plugin-terminals",
  "type": "module",
  "version": "1.4.0",
  "description": "Devframe plugin providing terminal panels for streamed output and interactive PTY shells.",
  "author": "Anthony Fu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/devframes/devframe#readme",
  "repository": {
    "directory": "plugins/terminals",
    "type": "git",
    "url": "git+https://github.com/devframes/devframe.git"
  },
  "bugs": "https://github.com/devframes/devframe/issues",
  "keywords": [
    "devframe",
    "devtools",
    "terminal",
    "pty",
    "xterm"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/node/index.mjs",
    "./cli": "./dist/node/cli.mjs",
    "./client": "./dist/client/index.mjs",
    "./constants": "./dist/node/constants.mjs",
    "./node": "./dist/node/setup.mjs",
    "./rpc": "./dist/node/rpc/index.mjs",
    "./types": "./dist/node/types.mjs",
    "./vite": "./dist/node/vite.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/node/index.d.mts",
  "bin": {
    "devframe-terminals": "./bin.mjs"
  },
  "files": [
    "bin.mjs",
    "dist"
  ],
  "peerDependencies": {
    "@devframes/plugin-terminals--assets": "1.4.0",
    "devframe": "1.4.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@devframes/plugin-terminals--assets": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@devframes/vite": "1.4.0",
    "cac": "^7.1.0",
    "zigpty": "^0.2.1"
  },
  "devDependencies": {
    "@antfu/design": "^0.6.0",
    "@devframes/plugin-terminals--assets": "1.4.0",
    "@iconify-json/ph": "^1.2.2",
    "@storybook/svelte-vite": "^10.6.7",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "colorjs.io": "^0.7.1",
    "devframe": "1.4.0",
    "h3": "^2.0.8",
    "storybook": "^10.6.7",
    "svelte": "^5.57.3",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "unocss": "^66.13.0",
    "vite": "^8.3.8",
    "vite-plugin-css-injected-by-js": "^5.0.3",
    "vitest": "^5.1.0",
    "ws": "^8.23.0"
  },
  "scripts": {
    "build": "tsdown && vite build --config app/client/vite.config.ts && vite build --config app/vite.config.ts",
    "build:client": "vite build --config app/client/vite.config.ts",
    "build:app": "vite build --config app/vite.config.ts",
    "watch": "tsdown --watch",
    "dev": "vite --config app/vite.config.ts --host",
    "play": "pnpm run build && node playgrounds/server.mjs",
    "storybook": "storybook dev -p 6014",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}